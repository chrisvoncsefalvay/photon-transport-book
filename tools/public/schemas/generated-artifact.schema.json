{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated scientific artefact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "chapter",
    "experiment",
    "source_commit",
    "generator",
    "mode",
    "parameters",
    "outputs",
    "stochastic",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "chapter": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "exact-client-calculation",
        "deterministic-precomputed-sweep",
        "recorded-optimisation-trajectory",
        "stochastic-independent-realisations"
      ]
    },
    "device": {
      "type": ["string", "null"]
    },
    "cuda_version": {
      "type": ["string", "null"]
    },
    "warp_version": {
      "type": ["string", "null"]
    },
    "precision": {
      "type": ["string", "null"]
    },
    "parameters": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interpolation": {
      "type": ["object", "null"]
    },
    "stochastic": {
      "type": "boolean"
    },
    "seeds": {
      "type": ["array", "null"],
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "bootstrap": {
      "type": "boolean"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "source_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "output_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
