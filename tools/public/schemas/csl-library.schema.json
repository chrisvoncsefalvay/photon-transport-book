{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bootstrap CSL-JSON library contract",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "type", "title", "issued"],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
      "type": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "author": { "type": "array" },
      "issued": { "type": "object" },
      "DOI": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
      "URL": { "type": "string", "format": "uri" }
    }
  }
}
