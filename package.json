{
  "name": "differentiable-photon-transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "source:generate": "node tools/public/generate-source-manifest.mjs",
    "dev": "pnpm run source:generate && astro dev",
    "build": "pnpm run source:generate && astro build",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "pnpm run source:generate && astro check",
    "typecheck": "pnpm run check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:site && pnpm run test:tooling",
    "test:site": "vitest run tests/site",
    "test:tooling": "node --test tools/public/*.test.mjs tests/tooling/*.test.mjs",
    "validate:public": "node tools/public/validate-all.mjs",
    "verify:site": "pnpm run check && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run validate:public && pnpm run build:site",
    "build:vercel": "node tools/public/build-deployment.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@mdx-js/mdx": "3.1.1",
    "astro": "7.3.1",
    "katex": "0.16.47",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "three": "0.185.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.1",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
