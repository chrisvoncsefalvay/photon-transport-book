---
import FigurePlate from "./FigurePlate.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
const columns = 4;
const rows = 3;
const columnPitch = 0.4;
const rowPitch = 0.6;
const scale = 140;
const origin = { x: 178, y: 191 };
const format = (value: number) =>
  (Math.abs(value) < 1e-10 ? "0" : value.toFixed(1)).replace("-", "−");
const pixels = Array.from({ length: columns * rows }, (_, index) => {
  const i = index % columns;
  const j = Math.floor(index / columns);
  const x = (i - (columns - 1) / 2) * columnPitch;
  const y = (j - (rows - 1) / 2) * rowPitch;
  return {
    index,
    i,
    j,
    cx: origin.x + x * scale,
    cy: origin.y - y * scale,
    coordinates: `(${format(x)}, ${format(y)}, 0) mm`,
  };
});
const initial = pixels[5]!;
---

<FigurePlate
  id={id}
  title="The origin is between pixel centres"
  description="The centred 4 × 3 detector places its origin between two columns and on the middle row. No extra half-pixel shift is needed."
>
  <pixel-centres-figure class="pixel-centres">
    <p class="pixel-centres__heading">4 columns × 3 rows · detector frame D</p>
    <div class="pixel-centres__layout">
      <div class="pixel-centres__drawing">
        <svg
          viewBox="-14 -16 388 410"
          role="img"
          aria-label="Detector pixel centres and rectangular cell boundaries. Column index i and x increase to the right, while row index j and y increase upwards. The origin is midway between centres (1,1) and (2,1)."
          data-grid
        >
          <title>A centred detector with unequal pixel pitches</title>
          <desc>
            Four columns of width 0.4 mm and three rows of height 0.6 mm fill a
            1.6 mm by 1.8 mm rectangle. Its geometric centre is the detector
            origin. First centre (0,0) is at (−0.6,−0.6,0) mm, and last centre
            (3,2) is at (0.6,0.6,0) mm.
          </desc>
          <rect
            class="pixel-centres__footprint"
            x="66"
            y="65"
            width="224"
            height="252"></rect>
          <g class="pixel-centres__boundaries" aria-hidden="true">
            {
              [1, 2, 3].map((column) => (
                <path d={`M ${66 + column * columnPitch * scale} 65 V 317`} />
              ))
            }
            {
              [1, 2].map((row) => (
                <path d={`M 66 ${65 + row * rowPitch * scale} H 290`} />
              ))
            }
          </g>
          <g class="pixel-centres__axes" aria-hidden="true">
            <path d="M 66 21 H 290 M 282 17 L 290 21 L 282 25"></path>
            <path d="M 25 317 V 65 M 21 73 L 25 65 L 29 73"></path>
          </g>
          <g class="pixel-centres__index-labels" aria-hidden="true">
            <text x="178" y="4" text-anchor="middle"
              >i / +x<tspan baseline-shift="sub" font-size="12">D</tspan></text
            >
            <text transform="translate(8 191) rotate(-90)" text-anchor="middle"
              >j / +y<tspan baseline-shift="sub" font-size="12">D</tspan></text
            >
            {
              pixels.slice(0, columns).map((pixel) => (
                <text x={pixel.cx} y="51" text-anchor="middle">
                  {pixel.i}
                </text>
              ))
            }
            {
              [0, 1, 2].map((j) => (
                <text
                  x="48"
                  y={origin.y - (j - 1) * rowPitch * scale + 6}
                  text-anchor="middle"
                >
                  {j}
                </text>
              ))
            }
          </g>
          <g class="pixel-centres__pixels">
            {
              pixels.map((pixel) => (
                <g
                  class:list={[
                    "pixel-centres__pixel",
                    { "is-selected": pixel.index === initial.index },
                  ]}
                  data-pixel={pixel.index}
                  data-i={pixel.i}
                  data-j={pixel.j}
                  data-coordinates={pixel.coordinates}
                  aria-label={`Pixel (${pixel.i}, ${pixel.j}), centre ${pixel.coordinates}`}
                >
                  <circle
                    class="pixel-centres__target"
                    cx={pixel.cx}
                    cy={pixel.cy}
                    r="22"
                  />
                  <circle
                    class="pixel-centres__selection"
                    cx={pixel.cx}
                    cy={pixel.cy}
                    r="13"
                  />
                  <circle
                    class="pixel-centres__dot"
                    cx={pixel.cx}
                    cy={pixel.cy}
                    r="5"
                  />
                </g>
              ))
            }
          </g>
          <g class="pixel-centres__origin" aria-hidden="true">
            <circle cx={origin.x} cy={origin.y} r="6"></circle>
            <path d="M 174 191 H 182 M 178 187 V 195 M 178 203 V 226 H 301"
            ></path>
            <text x="307" y="232">origin</text>
          </g>
          <g class="pixel-centres__dimension" aria-hidden="true">
            <path d="M 66 333 V 347 M 66 340 H 290 M 290 333 V 347"></path>
            <text x="178" y="367" text-anchor="middle"
              >1.6 mm × 1.8 mm footprint</text
            >
          </g>
        </svg>
        <p class="pixel-centres__legend">
          <span
            ><span
              class="pixel-centres__key pixel-centres__key--dot"
              aria-hidden="true"></span>Pixel centre</span
          >
          <span
            ><span
              class="pixel-centres__key pixel-centres__key--cell"
              aria-hidden="true"></span>Cell boundary</span
          >
        </p>
      </div>
      <div class="pixel-centres__details">
        <div class="pixel-centres__selection-panel">
          <label class="pixel-centres__control" hidden>
            Select a pixel (i, j)
            <select data-pixel-select>
              {
                pixels.map((pixel) => (
                  <option
                    value={pixel.index}
                    selected={pixel.index === initial.index}
                  >
                    ({pixel.i}, {pixel.j})
                  </option>
                ))
              }
            </select>
          </label>
          <p class="pixel-centres__selected-label">
            Centre of pixel <span data-selected-label>(1, 1)</span> in D
          </p>
          <output
            class="pixel-centres__readout"
            aria-live="polite"
            aria-atomic="true"
            data-coordinate-readout>{initial.coordinates}</output
          >
          <p class="pixel-centres__help" data-interaction-help hidden>
            Choose a centre or use the selector. On the grid, arrow keys move
            one pixel. ↑ increases j.
          </p>
        </div>
        <dl class="pixel-centres__facts">
          <div><dt>Column pitch Δ<sub>c</sub></dt><dd>0.4 mm</dd></div>
          <div><dt>Row pitch Δ<sub>r</sub></dt><dd>0.6 mm</dd></div>
          <div><dt>First centre (0, 0)</dt><dd>(−0.6, −0.6, 0) mm</dd></div>
          <div><dt>Last centre (3, 2)</dt><dd>(0.6, 0.6, 0) mm</dd></div>
        </dl>
        <p class="pixel-centres__extent">
          Cell edges extend to x = ±0.8 mm and y = ±0.9 mm. Every centre has z =
          0.
        </p>
      </div>
    </div>
  </pixel-centres-figure>
</FigurePlate>

<script>
  class PixelCentresFigure extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const selector = this.querySelector<HTMLSelectElement>(
        "[data-pixel-select]",
      );
      const grid = this.querySelector<SVGSVGElement>("[data-grid]");
      const pixels = Array.from(
        this.querySelectorAll<SVGGElement>("[data-pixel]"),
      );
      const label = this.querySelector<HTMLElement>("[data-selected-label]");
      const readout = this.querySelector<HTMLOutputElement>(
        "[data-coordinate-readout]",
      );
      if (!selector || !grid || !label || !readout || pixels.length !== 12)
        return;

      const select = (index: number, focus = false) => {
        const selected = pixels[index];
        if (!selected) return;
        selector.value = String(index);
        label.textContent = `(${selected.dataset.i}, ${selected.dataset.j})`;
        readout.textContent = selected.dataset.coordinates ?? "";
        pixels.forEach((pixel, position) => {
          pixel.classList.toggle("is-selected", position === index);
          pixel.setAttribute("aria-pressed", String(position === index));
          pixel.setAttribute("tabindex", position === index ? "0" : "-1");
        });
        if (focus) selected.focus();
      };

      grid.setAttribute("role", "group");
      pixels.forEach((pixel, index) => {
        pixel.setAttribute("role", "button");
        pixel.addEventListener("click", () => select(index, true), { signal });
        pixel.addEventListener(
          "keydown",
          (event) => {
            const i = index % 4;
            const j = Math.floor(index / 4);
            const next: Record<string, number> = {
              ArrowLeft: j * 4 + Math.max(0, i - 1),
              ArrowRight: j * 4 + Math.min(3, i + 1),
              ArrowUp: Math.min(2, j + 1) * 4 + i,
              ArrowDown: Math.max(0, j - 1) * 4 + i,
              Home: 0,
              End: 11,
              Enter: index,
              " ": index,
            };
            const nextIndex = next[event.key];
            if (nextIndex !== undefined) {
              event.preventDefault();
              select(nextIndex, true);
            }
          },
          { signal },
        );
      });
      selector.addEventListener(
        "change",
        () => select(Number(selector.value)),
        { signal },
      );
      select(Number(selector.value));
      this.querySelectorAll<HTMLElement>("[hidden]").forEach((element) => {
        element.hidden = false;
      });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("pixel-centres-figure")) {
    customElements.define("pixel-centres-figure", PixelCentresFigure);
  }
</script>

<style>
  .pixel-centres {
    display: block;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .pixel-centres p {
    margin: 0;
  }
  .pixel-centres [hidden] {
    display: none;
  }
  .pixel-centres__heading {
    font-weight: 600;
  }
  .pixel-centres__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-block: 1.5rem;
  }
  .pixel-centres__drawing {
    min-width: 0;
  }
  .pixel-centres svg {
    display: block;
    width: 100%;
    max-width: 24rem;
    margin-inline: auto;
    overflow: visible;
  }
  .pixel-centres svg text {
    fill: var(--ink);
    font-family: var(--font-ui);
    font-size: 18px;
  }
  .pixel-centres__footprint {
    fill: var(--paper-raised);
    stroke: var(--ink-muted);
    stroke-width: 1.5;
  }
  .pixel-centres__boundaries {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .pixel-centres__axes,
  .pixel-centres__dimension {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1.25;
  }
  .pixel-centres__dimension text {
    stroke: none;
    font-size: 17px !important;
  }
  .pixel-centres__target {
    fill: transparent;
  }
  .pixel-centres__selection {
    fill: transparent;
    stroke: transparent;
    stroke-width: 2.5;
  }
  .pixel-centres__dot {
    fill: var(--technical);
  }
  .pixel-centres__pixel[role="button"] {
    cursor: pointer;
    outline: none;
  }
  .pixel-centres__pixel.is-selected .pixel-centres__selection {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }
  .pixel-centres__pixel.is-selected .pixel-centres__dot {
    fill: var(--accent);
  }
  .pixel-centres__pixel:focus-visible .pixel-centres__target {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 3 3;
  }
  .pixel-centres__origin {
    pointer-events: none;
  }
  .pixel-centres__origin circle {
    fill: var(--paper-raised);
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .pixel-centres__origin path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .pixel-centres__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    font-size: 0.8rem;
  }
  .pixel-centres__legend > span {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .pixel-centres__key {
    display: inline-block;
    flex-shrink: 0;
  }
  .pixel-centres__key--dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--technical);
  }
  .pixel-centres__key--cell {
    width: 0.7rem;
    height: 1rem;
    border: 1px solid var(--ink-muted);
  }
  .pixel-centres__details {
    min-width: 0;
  }
  .pixel-centres__selection-panel {
    border-block: 1px solid var(--rule);
    padding-block: 1rem;
  }
  .pixel-centres__control {
    display: grid;
    gap: 0.5rem;
    margin-block-end: 1rem;
    font-weight: 600;
  }
  .pixel-centres__control select {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
    background: var(--paper-raised);
    color: var(--ink);
    font: inherit;
    padding: 0.5rem 0.75rem;
  }
  .pixel-centres__control select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .pixel-centres__selected-label {
    color: var(--ink-muted);
  }
  .pixel-centres__readout {
    display: block;
    color: var(--accent);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    overflow-wrap: anywhere;
    margin-block: 0.25rem 0.5rem;
  }
  .pixel-centres__help,
  .pixel-centres__extent {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .pixel-centres__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    margin-block: 1rem;
  }
  .pixel-centres__facts > div {
    min-width: 0;
  }
  .pixel-centres__facts > div:nth-child(n + 3) {
    grid-column: 1 / -1;
  }
  .pixel-centres__facts dt {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .pixel-centres__facts dd {
    margin: 0.15rem 0 0;
    font-variant-numeric: tabular-nums;
  }
  .pixel-centres__facts sub {
    vertical-align: sub;
    font-size: 0.7rem;
  }

  @media (min-width: 45rem) {
    .pixel-centres__layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
    }
  }
</style>
