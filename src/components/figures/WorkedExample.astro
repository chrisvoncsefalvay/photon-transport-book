---
import { readFileSync } from "node:fs";
import FigurePlate from "./FigurePlate.astro";
import RecordedPlot from "./RecordedPlot.astro";
import WorkedRaster from "./WorkedRaster.astro";
import { workedExamplePlots } from "../../lib/worked-example-plots";
import "../../styles/application-results.css";

interface ResultFigure {
  schema_version: number;
  passed: boolean;
  title: string;
  description: string;
  images: {
    file: string;
    pdf?: string;
    alt: string;
    width: number;
    height: number;
  }[];
  measurements: { label: string; value: string; criterion: string }[];
  reading: string;
}

interface Props {
  id: string;
  example: "registration" | "reconstruction" | "acquisition";
}

const { id, example } = Astro.props;
const result = JSON.parse(
  readFileSync(
    new URL(
      `../../../public/generated/worked-examples/${example}/study.json`,
      import.meta.url,
    ),
    "utf8",
  ),
) as ResultFigure;
if (
  result.schema_version !== 1 ||
  result.passed !== true ||
  !result.measurements.length
) {
  throw new Error(
    `Worked example ${example} requires an accepted recorded result`,
  );
}
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/generated/worked-examples/${example}/`;
const plots = workedExamplePlots(example);
const explanations = {
  registration: {
    description:
      "Two simulated count images of CT-derived anatomy constrain a rigid pose. The renderer uses assigned attenuation at 80 keV and starts from the identity transform.",
    reading:
      "The gradient curve shows progress towards a stationary pose. Target-point error shows how the recovered transform acts on the anatomy; the image panels show the corresponding change in the projections.",
  },
  reconstruction: {
    description:
      "Starting from uniform water, reconstruct water and bone fractions on a 16³ trilinear grid from 48 simulated views. The two replicates use independent measurement noise.",
    reading:
      "The objective and projected-gradient curves show the progress of each solve. Use the material selector to compare the recovered water and bone fractions with their assigned reference fields; signed errors reveal which regions are overestimated or underestimated.",
  },
  acquisition: {
    description:
      "Choose a second view using pose sensitivities, then compare its target-point error with a near-parallel view at the same exposure.",
    reading:
      "The selected view reduces mean squared target error by 71% across the eight paired noise realisations. Two pairs have higher error after selection: the criterion predicts an average over possible images, whereas each refit uses one particular noisy pair of images.",
  },
}[example];
---

<FigurePlate
  {id}
  title={result.title}
  description={explanations.description}
  width="full"
>
  <div class="application-results worked-example">
    {
      example === "registration" && (
        <WorkedRaster {example} id={`${id}-images`} />
      )
    }
    <div class="application-plots worked-example__plots">
      {
        plots.map(({ key, ...plot }) => (
          <RecordedPlot id={`${id}-${key}`} {...plot} />
        ))
      }
    </div>
    {
      example === "reconstruction" && (
        <WorkedRaster {example} id={`${id}-materials`} />
      )
    }
    <p class="application-reading">{explanations.reading}</p>
    <details class="application-details worked-example__data">
      <summary>Inspect the example data</summary>
      <div class="worked-example__links">
        <a href={`${base}data.json`} download>Download the numerical record</a>
        <a href={`${base}study.json`} download>Full numerical results</a>
        <a href={`${base}provenance.json`}>Data sources and computation</a>
      </div>
    </details>
  </div>
</FigurePlate>

<style>
  .worked-example {
    font-family: var(--font-ui);
    line-height: 1.5;
  }
  .worked-example__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    padding-block: 0.35rem 0.65rem;
  }
</style>
